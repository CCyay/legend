  // 官方：Lv.0，效果是「展示手牌」；展示的牌不发动效果
  ['blacksmith', '展示手牌。被展示的牌不发动效果（只有从手牌打出的牌才发动效果）；但带蓝标的 ∞ 持续牌可直接放置到场上，无需收回并可立即使用效果。'],
  ['fighter', '消耗1行动：铺全部手牌；铺牌总数偶数且无纹章卡在场，+1金。'],
  ['guard', '被攻击时打出：无效本次攻击，攻击卡放置攻击者场上，随后摸1张牌。卫兵相邻卡无法被翻面。'],
  ['nun', '对手弃置LV≥2卡牌时，直接将该弃牌收入自己手牌。'],
  // 官方：宣言对手手牌「没有」什么，对手有一次机会亮牌
  ['mage', '宣言一项对手手牌中「没有」的内容；对手有一次机会亮出手牌说「我有」。除此情况外，你获得一枚金币。'],
  ['hero_lv4', '将一名其他角色的一张魔物手牌放置于其场上，若此牌等级低于此【勇者】，你获得一枚金币。'],
  ['hero_lv5', '将一名其他角色的一张魔物手牌放置于其场上，若此牌等级低于此【勇者】，你获得一枚金币。'],
  // 官方：Lv.4 勇者的替换牌，「此卡牌的名字也视作勇者」
  ['berserker', '此卡牌的名字也视作【勇者】，效果与Lv.4【勇者】相同。'],
  // 官方：Lv.1；对手付不起金币即无法完全执行，此牌不能打出
  ['merchant', '指定金币多于自己的对手，强制对方支付1金。对方无法支付时属于无法完全执行，此牌不能打出。'],
  ['holy_knight', '全场皇室LV+2；抵消全部LV≤3魔物攻击。'],
  ['great_wizard', '宣言1个LV数字，对手交出对应等级手牌；无对应卡牌则己方+1金。'],
  ['dragon_egg', '打出火龙的前置条件；不受卫兵翻面限制。'],
  ['fire_dragon', '需龙蛋在场才能打出。对手抽牌时，可弃1手牌夺走对手刚抽的牌。'],
  // 官方：由龙幼崽的使用者决定让哪张牌返回手牌
  ['dragon_whelp', '令目标场上的一张牌返回其手牌，由本卡的使用者决定返回哪一张。'],
  ['fairy', '对手每弃置1张手牌，自己+1金币。'],
  ['goblin', '宣言对手卡牌名称，持有则弃置；卡牌带LV则己方+1金。'],
  ['white_bone', '所有对手场上持续卡强制收回手牌。'],
  ['witch', '被皇室攻击时打出：强制攻击者翻面1张场上卡，该卡本回合无法触发效果。'],
  ['dragon_flame', '全体对手场上所有持续卡强制竖置重置。'],
  ['slime', '打出直接获得1金币；单回合限打1张。'],
  // 官方：放置到对手场上的 debuff，对手手牌满 5 张时解除
  ['bomb_monster', '打出后放置在对手场上。对手每回合准备阶段不能把此牌拿回手牌，且必须改为将自己场上另一张牌拿回手牌。当对手手牌达到 5 张时炸弹怪解除，他立即弃置此牌。'],
  ['demon_lord', '双方每回合抽牌数量-1（双人局）。'],
  ['treasure_monster', '自己即将获得金币时打出：本次金币数量翻倍，使用后直接弃置。'],
  ['black_knight', '放置对手1张手牌至其场上；目标带LV则+1金；目标带皇冠纹章，从任意弃牌区拿魔剑入手。'],
  // 官方：可与圣剑被勇者/狂战士双持，横置后为下一张勇者附加 Buff
  ['magic_sword', '可与【圣剑】被【勇者】/【狂战士】双持，持剑时机由你决定。横置此牌后，下一张【勇者】带上 Buff：可攻击皇室牌，且不弃置勇者、改为将其放置到场上。']
])

export function getCardDescription(cardId : string) : string {
  const desc = DESCRIPTION_MAP.get(cardId)
  return desc != null ? desc : '暂无效果说明'
}

export function getCardTypeLabel(cardType : string) : string {
  if (cardType == 'attack') return '攻击'
  if (cardType == 'trigger') return '触发'
  if (cardType == 'continuous') return '持续'
  return cardType
}

export function getCardTypeIcon(cardType : string) : string {
  if (cardType == 'attack') return '△'
  if (cardType == 'trigger') return '⚡'
  if (cardType == 'continuous') return '●'
  return ''
}

/** 官方：纹章高于 Lv，但纹章之间平级，互相没有大小关系 */
export function getEmblemLabel(emblem : string) : string {
  if (emblem == 'crown') return '皇冠'
  if (emblem == 'dragon') return '火焰'
  if (emblem == 'demon') return '恶魔'
  return ''
}
