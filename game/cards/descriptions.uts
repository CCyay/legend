 * https://www.gstonegames.com/bbs/discuss-3-26145-1.html
 * 未标注的条目沿用原有实现，尚未与官方规则书核对。
 */
const DESCRIPTION_MAP : Map<string, string> = new Map([
  ['king', '横置此牌，获得弃牌区一张Lv.4的【勇者】。'],
