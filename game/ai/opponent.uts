import type { GameState, Intent, DrawPile } from '../types.uts'
import { AI_PLAYER_ID, HUMAN_PLAYER_ID } from '../types.uts'
import { getCardDef } from '../cards/catalog.uts'
import { canPlayCard } from '../effects/handlers/index.uts'
import { SeededRng } from '../rng.uts'

/**
 * 选一个牌库抽起手牌。rng 由调用方传入并跨多次抽牌复用——
 * 若在此处 new SeededRng，同一轮起手的每次调用种子相同，三张必定选到同一牌库。
 */
export function chooseOpeningPile(state : GameState, rng : SeededRng) : DrawPile | null {
  const royalLen = state.royalDeck.length
  const monsterLen = state.monsterDeck.length
  if (royalLen == 0 && monsterLen == 0) return null
  if (royalLen == 0) return 'monster'
  if (monsterLen == 0) return 'royal'
  // 略偏向牌库较多的阵营，仍带随机性
  return rng.nextInt(royalLen + monsterLen) < royalLen ? 'royal' : 'monster'
}

export function pickAiOpeningHandIntents(state : GameState) : Intent[] {
  const intents : Intent[] = []
  let simulated = state
  const choice = simulated.pendingChoice
  if (choice == null || choice.type != 'openingHand') return intents
  let remaining = choice.remaining

  // 整轮起手共用一个 rng，逐次取值，保证 3 次抽牌相互独立
  const rng = new SeededRng(state.seed + state.tick * 31 + remaining)

  while (remaining > 0) {
    const pile = chooseOpeningPile(simulated, rng)
    if (pile == null) break
    intents.push({
      type: 'pickOpeningHand',
      playerId: AI_PLAYER_ID,
      pile
    })
    const deck = pile == 'royal' ? simulated.royalDeck : simulated.monsterDeck
    if (deck.length == 0) break
    const newDeck = deck.slice(1)
    remaining = remaining - 1
    simulated = {
      ...simulated,
      royalDeck: pile == 'royal' ? newDeck : simulated.royalDeck,
      monsterDeck: pile == 'monster' ? newDeck : simulated.monsterDeck,
      pendingChoice: remaining > 0
        ? { type: 'openingHand', playerId: AI_PLAYER_ID, remaining }
        : simulated.pendingChoice
    }
  }
  return intents
}

/**
 * 从目标玩家手牌中挑选。勇者场景下优先选等级最低的牌，
 * 因为「被放置牌等级低于勇者」才能拿到那 1 枚金币。
 */
function pickAiHandSelection(
  state : GameState,
  targetPlayerId : string,
  count : number,
  filter : string | null
) : Intent[] {
  const target = state.players.find((p) => p.id == targetPlayerId)
  if (target == null) return []

  const candidates = target.hand.filter((c) : boolean => {
    if (filter == null) return true
    const def = getCardDef(c.defId)
    return def != null && def.faction == filter
  })
  if (candidates.length < count) return []

  const sorted = candidates.slice().sort((a, b) : number => {
    const da = getCardDef(a.defId)
    const db = getCardDef(b.defId)
    return (da?.level ?? 99) - (db?.level ?? 99)
  })

  return [{
    type: 'selectTargets',
    playerId: AI_PLAYER_ID,
    instanceIds: sorted.slice(0, count).map((c) : string => c.instanceId)
  }]
}

export function pickAiTurn(state : GameState) : Intent[] {
  if (state.phase == 'gameover') return []

  // 待 AI 做的选牌请求（如勇者选择对手魔物手牌）优先处理，否则对局会卡住
  const pending = state.pendingChoice
  if (pending != null && pending.type == 'pickHand' && pending.playerId == AI_PLAYER_ID) {
    return pickAiHandSelection(state, pending.targetPlayerId, pending.count, pending.filter ?? null)
  }

  if (state.phase == 'opening_hand') {
    const choice = state.pendingChoice
    if (choice != null && choice.type == 'openingHand' && choice.playerId == AI_PLAYER_ID) {
      return pickAiOpeningHandIntents(state)
    }
    return []
  }

  const intents : Intent[] = []

  if (state.responseWindow != null && state.responseWindow.targetId == AI_PLAYER_ID) {
    const ai = state.players.find((p) => p.id == AI_PLAYER_ID)
    if (ai != null) {
      for (let i = 0; i < ai.hand.length; i++) {
        const card = ai.hand[i]
        const def = getCardDef(card.defId)
        if (def != null && def.cardType == 'trigger' && def.id == 'guard') {
          if (canPlayCard(state, AI_PLAYER_ID, card.instanceId)) {
            intents.push({ type: 'playCard', playerId: AI_PLAYER_ID, instanceId: card.instanceId })
            return intents
          }
        }
      }
    }
    intents.push({ type: 'passResponse', playerId: AI_PLAYER_ID })
    return intents
  }

  if (state.activePlayerId != AI_PLAYER_ID) return []

  if (state.phase == 'main') {
    const ai = state.players.find((p) => p.id == AI_PLAYER_ID)
    if (ai == null) return intents

    for (let i = 0; i < ai.hand.length; i++) {
      const card = ai.hand[i]
      const def = getCardDef(card.defId)
      if (def != null && def.id == 'slime' && canPlayCard(state, AI_PLAYER_ID, card.instanceId)) {
        intents.push({ type: 'playCard', playerId: AI_PLAYER_ID, instanceId: card.instanceId })
        if (state.actionPoints <= 1) {
          intents.push({ type: 'endPhase', playerId: AI_PLAYER_ID })
        }
        return intents
      }
    }

    if (state.actionPoints > 0) {
      const pile = state.monsterDeck.length > 0 ? 'monster' : 'royal'
      intents.push({ type: 'draw', playerId: AI_PLAYER_ID, pile: pile as 'royal' | 'monster' })
    }

    if (state.actionPoints > 1) {
      intents.push({ type: 'draw', playerId: AI_PLAYER_ID, pile: 'royal' })
    }

    intents.push({ type: 'endPhase', playerId: AI_PLAYER_ID })
    return intents
  }

  if (state.phase == 'end' && state.pendingChoice != null) {
    const choice = state.pendingChoice
    if (choice.type == 'discard' && choice.playerId == AI_PLAYER_ID) {
      const ai = state.players.find((p) => p.id == AI_PLAYER_ID)
      // 张数必须严格等于 choice.count，否则 handleDiscard 会拒绝，AI 就卡在结束阶段
      if (ai != null && choice.count > 0 && ai.hand.length >= choice.count) {
        const toDiscard = ai.hand.slice(0, choice.count).map((c) : string => c.instanceId)
        intents.push({ type: 'discard', playerId: AI_PLAYER_ID, instanceIds: toDiscard })
      }
    }
  }

  return intents
}
